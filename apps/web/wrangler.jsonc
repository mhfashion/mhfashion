{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mhfashion",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // R2 bindings (Plan 12.2.1). Both are required: the public bucket holds the pictures, fonts
  // and artwork; the private one holds customer files, order files and the catalogue snapshots.
  // Add them here once the buckets exist:
  // "r2_buckets": [
  //   { "binding": "MH_FASHION_ASSETS", "bucket_name": "mh-fashion-assets" },
  //   { "binding": "MH_FASHION_PRIVATE", "bucket_name": "mh-fashion-private" }
  // ]
  // A durable rate-limit counter (Plan §16 P1-9). Create the namespace with
  // `npx wrangler kv namespace create mh-fashion-rate-limit`, then add:
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "<the namespace id>" }
  // ]
}
