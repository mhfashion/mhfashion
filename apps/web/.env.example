# Every variable here is read by the code (Plan §19.4). `tests/env-example.test.cjs` fails when this file
# and the code drift apart in either direction, so add a name here when you read it and delete it when you
# stop. Worker-only secrets go in with `wrangler secret put <NAME>`; they are not build-time values.

# Supabase — the catalogue, guide, search, staff roles (public read; the anon key is meant to be public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. It reads customer search terms, so only the guarded admin route touches it.
SUPABASE_SERVICE_ROLE_KEY=

# Staff API guard (Plan §19.10 S1): a bearer token the shop's own tooling presents to /api/admin/*
ADMIN_API_TOKEN=

# Public origin for canonical and share URLs (no path, https)
NEXT_PUBLIC_SITE_URL=

# Public host that serves R2 objects (pictures, fonts, artwork)
NEXT_PUBLIC_R2_PUBLIC_URL=

# The shop's contact address shown in the footer and on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# MH Delivery — the quote endpoint, and the token the quote route sends with it. MH_DELIVERY_URL is the
# server-side endpoint; NEXT_PUBLIC_MH_DELIVERY_URL is the one the browser may name.
NEXT_PUBLIC_MH_DELIVERY_URL=
MH_DELIVERY_URL=
MH_DELIVERY_TOKEN=

# Payments — one shared signing secret plus each provider's own credentials
PAYMENT_WEBHOOK_SECRET=
# "0" turns the demo provider (and /api/payments/simulate) off. Set this to 0 in production.
PAYMENTS_ALLOW_MOCK=
KBZPAY_APP_ID=
KBZPAY_SECRET=
WAVEPAY_MERCHANT_ID=
WAVEPAY_SECRET=
AYAPAY_MERCHANT_ID=
AYAPAY_SECRET=
CARD_ACQUIRER_KEY=

# Bindings, not environment variables: set in apps/web/wrangler.jsonc.
#   RATE_LIMIT_KV  the durable rate-limit counter (KV namespace)
#   MH_FASHION_ASSETS / MH_FASHION_PRIVATE  the two R2 buckets
