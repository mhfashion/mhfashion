{
  "name": "mh-fashion",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test:guide": "node --test tests/guides.test.cjs",
    "test:browser-guards": "node --test tests/browser-guards.test.cjs",
    "test:canvas-spec": "node --test tests/canvas-spec.test.cjs",
    "test:canvas-shell": "node --test tests/canvas-shell.test.cjs",
    "test:editor-layers": "node --test tests/editor-layers.test.cjs",
    "test:editor-pen-path": "node --test tests/editor-pen-path.test.cjs",
    "test:editor-price": "node --test tests/editor-price.test.cjs",
    "test:photo-adjustments": "node --test tests/photo-adjustments.test.cjs",
    "test:guide:http": "node --test tests/guide-http.test.cjs",
    "test:admin-data": "node --test tests/admin-demo-data.test.cjs",
    "test:admin-posts": "node --test tests/admin-posts.test.cjs",
    "fonts:check": "node scripts/check-font-manifest.cjs",
    "guide:seed": "node scripts/seed-guide.cjs"
  }
}
