{
  "name": "mh-fashion",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test:guide": "node --test tests/guides.test.cjs",
    "test:browser-guards": "node --test tests/browser-guards.test.cjs",
    "test:canvas-spec": "node --test tests/canvas-spec.test.cjs",
    "test:canvas-shell": "node --test tests/canvas-shell.test.cjs",
    "test:guide:http": "node --test tests/guide-http.test.cjs"
  }
}
